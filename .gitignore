# ---------------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------------
.env
.env.*
*.local
!.env.example
!**/.env.example
# Web build config is public, non-secret and environment-specific — commit it
# (real secrets stay in .env / *.local, still ignored above). See web/.gitignore.
!web/.env.development
!web/.env.production

# ---------------------------------------------------------------------------
# Machine learning model weights (large binaries - keep out of git)
# ---------------------------------------------------------------------------
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.pb
*.gguf
*.joblib
*.pkl
services/ml/models/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
develop-eggs/
downloads/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Node / frontend (web/)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------------
# Logs / temp
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/

# ---------------------------------------------------------------------------
# Datagen v2 generated fixtures (evidence files, manifests, backup markers).
# Never commit large/generated synthetic files (roadmap Prompt 1 §F).
# ---------------------------------------------------------------------------
datagen/fixtures/

# ---------------------------------------------------------------------------
# Geo boundary raw downloads (full-resolution KGIS source, ~44 MB).
# Only the simplified, vendored datagen/geo/*.geojson are committed; the raw
# source can be re-fetched via datagen/geo/SOURCES.md + build_boundaries.py.
# ---------------------------------------------------------------------------
datagen/geo/raw/

# ---------------------------------------------------------------------------
# Zoho Catalyst (Phase 14)
# Commit SAFE config only: infra/catalyst/.catalystrc, catalyst.json,
# app-config.json, client-package.json, functions/*/*-config.json.
# NEVER commit local auth tokens, caches, build archives or secret env files.
# The CLI auth token lives in the user home (~/.catalyst), outside this repo.
# ---------------------------------------------------------------------------
.catalyst/
**/.catalyst/
.catalystcache
**/__catalyst_generated__/
infra/catalyst/**/node_modules/
infra/catalyst/**/target/
infra/catalyst/.deploy/
infra/catalyst/**/*.zip
infra/catalyst/functions/**/.env
infra/catalyst/**/secrets.json
# Catalyst / AWS deployment secrets and generated migration exports
infra/catalyst/secrets/
infra/**/serving-export/
infra/**/*.export.jsonl
infra/**/*.import-config.local.json
# Generated migration/reconciliation/fixture-copy reports (underscore-prefixed).
infra/catalyst/**/_*-report.json

# Prompt 23 throwaway REST/probe scripts (local debugging only; never committed)
artifacts/**/_*.py
# Console session captures (contain live browser session cookies/CSRF) — NEVER commit
artifacts/**/_console_capture*
artifacts/**/_capture*
artifacts/**/_*.curl
artifacts/**/_*.har
artifacts/**/_*.json
artifacts/**/_*.js
artifacts/**/_*.mjs
artifacts/**/_*.state.json
artifacts/**/_creds*
artifacts/**/_*.png

# ---------------------------------------------------------------------------
# Cross-account database migration artifacts (pg_dump archive, restore list,
# TOC and logs). The dump contains the full synthetic dataset - large, and
# regenerable with pg_dump - so it is kept locally but never committed.
# ---------------------------------------------------------------------------
_migration/

# ---------------------------------------------------------------------------
# Pre-migration safety dumps written by scripts/migrations/backup_*.ps1.
# Same reasoning as _migration/ above: these are pg_dump archives of the
# synthetic corpus, taken immediately before a migration so it can be rolled
# back. Large, binary, and regenerable by re-running the backup script, so they
# stay on the machine that took them and are never committed.
# ---------------------------------------------------------------------------
backups/

# Local-only scratch areas used while provisioning face recognition and probing
# the AppSail image under its real memory cap. Both have held generated docker
# env-files containing DATABASE_URL, so they must never be committable.
.docker-temp/
.face-ingest-logs/

# ---------------------------------------------------------------------------
# Curated public-source case imagery. THIS REPOSITORY IS PUBLIC, and these are
# pictures of real, identifiable people connected to a criminal trial that is
# still pending:
#
#   * user-supplied-reference.jpg is a copyrighted editorial/publicity
#     photograph. research/renukaswamy-case-evidence/index.html already records
#     the handling rule for this class of material -- publisher-hosted, linked
#     with attribution, "not copied into this repository", and licensed before
#     any public reuse. Committing it here would be exactly the redistribution
#     that rule exists to prevent.
#   * synthetic-persona-*.jpg are re-encodes of an AI-generated likeness. A
#     photorealistic fabricated image of a living person facing trial does not
#     belong in public version control under any label, and git history is not
#     something you can take back.
#
# Nothing depends on these bytes. The case record stores no imagery, the
# evidence manifest links publisher URLs, and scripts/setup_face_demo.py
# regenerates its two variants from any portrait passed with --source.
# ---------------------------------------------------------------------------
research/renukaswamy-case-evidence/assets/
