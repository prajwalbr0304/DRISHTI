# =============================================================================
# DRISHTI server configuration — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets, keys, passwords or tokens.
# The browser NEVER receives any of these — Browser -> FastAPI -> PostgreSQL/S3
# is the only permitted data path (hackathon access mode).
# =============================================================================

# --- Database (AWS RDS PostgreSQL) -------------------------------------------
# Full read/write connection string used by FastAPI + the data generator.
# Server-side only. URL-encode special characters in the password (@ -> %40).
# Example (placeholder — use your own host/user/password/db):
DATABASE_URL=postgresql://drishti_app:REPLACE_ME@your-db.REGION.rds.amazonaws.com:5432/drishti?sslmode=require

# NOLOGIN role assumed by the read-only connection layer (SELECT-only).
READONLY_ROLE=drishti_readonly

# --- Hackathon access mode (Phase 3) -----------------------------------------
# When HACKATHON_MODE=true the server REFUSES to start unless the target
# database is explicitly marked synthetic (synthetic_meta.app_environment).
HACKATHON_MODE=true
DEMO_DATA_ONLY=true
# The DB marker the server requires before it will run/write in hackathon mode.
SYNTHETIC_ENV_EXPECTED=synthetic_hackathon
# Intake WRITE endpoints stay localhost-only unless a trusted HTTPS edge is set.
INTAKE_WRITES_LOCALHOST_ONLY=true
# Canonical case-creating transitions (submit/approve). Enabled by default in
# Phase 3; set false to re-gate.
INTAKE_SUBMIT_ENABLED=true

# --- Network / demo guardrails (Phase 3) -------------------------------------
# Exact deployed demo frontend origin added to the CORS allow-list (no wildcard).
# Localhost dev/preview origins are always allowed. Leave blank for local only.
DEMO_FRONTEND_ORIGIN=
# Optional comma-separated extra CORS origins.
EXTRA_CORS_ORIGINS=
# Conservative per-client-IP request rate limit + request-body size cap (bytes).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BYTES=2000000

# --- Digital evidence storage: Amazon S3 (Phase 5) ---------------------------
# Files (already-digital synthetic evidence) live in a PRIVATE S3 bucket; only
# metadata/provenance lives in PostgreSQL. The browser never gets AWS creds —
# it uploads/downloads via short-lived exact-object pre-signed URLs the API mints.
# Credentials come from the environment: a local SSO profile in dev, or the
# ECS/instance task role in a deployment. NEVER put AWS access keys in .env,
# the frontend, images, or any committed file.
AWS_REGION=ap-south-1
# Local dev only: named SSO profile used by boto3 (run `aws sso login --profile <name>`).
# Leave blank in a deployment so the task role is used.
AWS_PROFILE=drishti
# Private evidence bucket (create with infra/aws/provision_evidence_bucket.py).
# Blank => the evidence API runs metadata-only (no file upload/download).
S3_EVIDENCE_BUCKET=
S3_EVIDENCE_PREFIX=evidence
# Short-expiry pre-signed URL lifetime (seconds).
S3_PRESIGN_EXPIRY_S=900
# Allow-list caps (file bytes go browser -> S3 directly, not through the API).
EVIDENCE_MAX_BYTES=52428800

# --- Ask DRISHTI scope flags (Prompt 19 §A) ----------------------------------
# Voice DICTATION of a question + spoken read-back are IN scope. This is kept
# strictly SEPARATE from evidence extraction. QUERY_VOICE may be true; evidence
# extraction (OCR, document/FIR field extraction, media transcription, face/
# object recognition) stays OFF for this submission.
QUERY_VOICE_ENABLED=true
EVIDENCE_EXTRACTION_ENABLED=false
# Dictation below this recogniser confidence must be confirmed/edited before it
# can execute (never auto-runs a low-confidence transcript).
VOICE_LOW_CONFIDENCE_THRESHOLD=0.6

# --- Semantic planner (Prompt 19 §B — Chinese-model-only, fail-closed) -------
# Only reviewed Chinese-origin model identities are accepted. Claude and
# GPT/OpenAI model IDs fail closed to the labelled deterministic planner.
#   "" | "aws_bedrock"
# Legacy QuickML and OpenAI-compatible arbitrary endpoint selectors are disabled
# because an endpoint URL cannot prove which model it actually serves.
SEMANTIC_PLANNER_PROVIDER=aws_bedrock
# Legacy QuickML settings are parsed for old environments but never selected.
QUICKML_LLM_ENDPOINT=
QUICKML_LLM_MODEL=
QUICKML_LLM_API_KEY=
QUICKML_LLM_TIMEOUT_S=30
# Legacy OpenAI-compatible settings are parsed for old environments but never
# selected. Keep blank; DRISHTI does not call OpenAI models or arbitrary hosts.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Amazon Bedrock Converse. The deployed AppSail sends a signed request through
# DRISHTI_AWS_ADAPTER_URL; AWS credentials stay on the Lambda execution role.
# This exact model is enforced by AppSail, the adapter, and least-privilege IAM.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=zai.glm-4.7-flash
# Local AWS development only; leave blank in Catalyst AppSail. To use the local
# boto3 credential chain, also opt in explicitly with DIRECT_SDK_ENABLED=true.
BEDROCK_AWS_PROFILE=
BEDROCK_DIRECT_SDK_ENABLED=false
BEDROCK_TIMEOUT_S=30

# --- Emergency Response live hazard feed (Phase 17) --------------------------
# Read-only LIVE weather feed = Open-Meteo (https://open-meteo.com): documented,
# free, NO API KEY, CC BY 4.0 (free for non-commercial use), covers Karnataka.
# Attribution shown in the UI: "Weather data by Open-Meteo.com (CC BY 4.0)".
# Ops kill-switch for all outbound live-feed calls (set false to force offline).
LIVE_FEED_ENABLED=true
# Endpoint (override only if self-hosting an Open-Meteo mirror). No credential.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
LIVE_FEED_TIMEOUT_S=12
# Official gauge networks (IMD/KSNDMC/CWC/WRD/GSI/FIRMS/FSI) are registration-
# gated (External Access Required); the recorded-sample connector proves the
# contract and swaps in when a licensed credential is provisioned.

# =============================================================================
# NOTE: The legacy Supabase project is no longer the source of truth (migrated
# to AWS RDS). Do NOT add SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY /
# DATABASE_URL or any credential to the web frontend or to any committed file.
# A Supabase publishable/anon client is NOT required for the hackathon.
# =============================================================================
