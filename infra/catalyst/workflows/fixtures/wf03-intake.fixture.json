{
  "workflow": "structured-intake-and-import",
  "fixture_status": "representative",
  "idempotency_key": "intake:draft-77:8b1e...",
  "input": {
    "draft": { "draft_id": "draft-77", "kind": "fir", "actor": "investigator:emp-12", "role": "investigator",
               "fields": { "crime_type": "theft", "location_district_id": 3, "brief": "synthetic draft" } },
    "then": { "supervisor_approval": { "actor": "supervisor:emp-3", "role": "supervisor", "decision": "approve" } }
