  },
  "lineage": { "staging_to_canonical": "stg-77 -> cv-1001", "approval_chain": ["investigator:emp-12", "supervisor:emp-3"] },
  "asserts": [
    "draft save and submission NEVER create a canonical CaseVersion or PredictionRequest",
