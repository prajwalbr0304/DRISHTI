# DRISHTI FastAPI — Catalyst AppSail custom-runtime (OCI) image (Phase 14).
#
# This is the PUBLIC API runtime deployed to Catalyst AppSail. It is separate
# from services/ml/Dockerfile (dev/all-in-one) and from services/gpu-worker
# (external AWS GPU). It is deliberately lightweight:
#
#   * NO torch / CUDA / TabFM / TabPFN / TimesFM / torch-geometric.
#   * The service dispatches PREDICTION work to the protected AWS adapter and
#     loads no forecasting/tabular model weights in-process.
#   * ONE exception: the face-recognition encoder (onnxruntime + the ~15 MB
#     buffalo_s pack) runs in-process, because 1:N biometric search has no
#     external adapter and its gallery is pgvector in RDS. Sized to fit the
#     512 MB instance — see the model-fetch step below.
#   * Runs as a non-root user, binds Uvicorn to 0.0.0.0 on the AppSail port
#     (9000 by default, matching `catalyst deploy appsail --port 9000`).
#   * Provides /health/live (liveness) and /health/ready (readiness).
#
# Build (requires Docker + buildx; see infra/catalyst/README.md):
#   docker buildx build --platform linux/amd64 \
#     -f services/ml/Dockerfile.appsail -t drishti-api:appsail --load services/ml
#
# Deploy (from infra/catalyst, project bound to DHRISTI):
#   catalyst deploy appsail --name drishti-api \
#     --source docker://drishti-api:appsail --port 9000

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_PORT=9000

WORKDIR /app

# Install the lightweight API dependency set only (no GPU/foundation packages).
COPY requirements.appsail.txt .
RUN pip install --no-cache-dir -r requirements.appsail.txt

# App code + SQL migrations. NO secrets baked in — all config comes from the
# AppSail environment configuration at runtime.
COPY app ./app
COPY sql ./sql

# Face-recognition weights (app/face). Baked at BUILD time, never fetched on the
# request path or at boot: a first face search must not block on network I/O, and
# an instance that starts without its weights would silently fall back to the
# non-biometric photo-descriptor encoder.
#
# The pack is buffalo_s (SCRFD-500MF + ArcFace MobileFaceNet, ~15 MB) rather than
# the buffalo_l used locally (~182 MB). This is a MEASURED constraint, not a
# preference: inside this instance's 512 MB cap buffalo_l is OOM-killed while
# loading the ArcFace R50 session (baseline app ~220 MB + R50 graph > 512 MB),
# where buffalo_s peaks at ~280 MB through a full search. Descriptors from the
# two packs are NOT comparable, so the enrolled gallery must be built with the
# same pack — see app/face/store.py and the ModelVersion scoping.
#
# DRISHTI_FACE_MODEL_URL can point at an internal mirror for an air-gapped build.
ENV DRISHTI_FACE_MODEL_DIR=/opt/face-models \
    DRISHTI_FACE_MODEL_PACK=buffalo_s \
    DRISHTI_FACE_LOW_MEMORY=true

# Match threshold CALIBRATED against the enrolled gallery, not left at the code
# default. The 0.36 in app/face/encoders.py is the standard ArcFace shortlist
# operating point for REAL photographs; this gallery is synthetic portraits from
# a single generator, so different people are systematically more alike than
# different people are in life.
#
# Measured over 600 random probes against the 15,343-face gallery, taking each
# probe's nearest DIFFERENT person (scripts/_face_calibrate.py):
#     impostor median 0.473, p95 0.580, p99 0.641, max 0.667
#     95% of impostor pairs exceed 0.36 — the default would surface a
#     confident-looking WRONG dossier on almost every probe
#     0 impostor pairs reach 0.70
# A genuine probe of an enrolled portrait scores ~0.9999 end to end (including
# the browser's downscale-to-1280 + JPEG re-encode), so 0.72 sits in the gap
# with margin on both sides.
#
# This is tuning, not a model property, which is why it lives here as an
# overridable ENV rather than being hardcoded in the encoder. RE-CALIBRATE if the
# gallery or the pack changes.
RUN python -c "from app.face import modelfiles; modelfiles.fetch('buffalo_s')" \
    && chmod -R a+rX /opt/face-models \
    && ls -l /opt/face-models/buffalo_s

# Declared AFTER the weight fetch on purpose: retuning a threshold must not
# invalidate the layer that downloads the model pack.
ENV DRISHTI_FACE_MATCH_THRESHOLD=0.72 \
    DRISHTI_FACE_STRONG_THRESHOLD=0.87

# Run as a non-root user.
RUN useradd --create-home --uid 10001 appuser
USER appuser

# AppSail routes traffic to this port (must match the deploy --port value).
EXPOSE 9000

# Liveness-based container healthcheck (dependency-free; no restart loops).
# Catalyst AppSail injects X_ZOHO_CATALYST_LISTEN_PORT at runtime; fall back to
# APP_PORT then 9000 for local docker runs.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os,urllib.request,sys; p=os.getenv('X_ZOHO_CATALYST_LISTEN_PORT') or os.getenv('APP_PORT','9000'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{p}/health/live').getcode()==200 else 1)"

# Bind to 0.0.0.0 on the AppSail-assigned port. Catalyst sets
# X_ZOHO_CATALYST_LISTEN_PORT and verifies the process is listening on it within
# 10s of instance start; APP_PORT (9000) is only a local-run fallback. EXPOSE
# above is Docker documentation only and does NOT set the AppSail port.
#
# `exec` REPLACES the shell so uvicorn becomes PID 1 and receives SIGTERM
# directly on `docker stop` / AppSail instance stop — enabling graceful
# shutdown (connection draining, lifespan shutdown) instead of a grace-period
# SIGKILL. Without exec the `sh -c` wrapper (PID 1) would swallow the signal.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${X_ZOHO_CATALYST_LISTEN_PORT:-${APP_PORT:-9000}}"]
