# DRISHTI web — env template. Copy to `.env.local` (gitignored) for personal
# overrides. Vite also auto-loads `.env.development` (dev server) and
# `.env.production` (production build) which ARE committed and hold the
# environment-specific, NON-SECRET defaults.
#
# HARD RULE: only PUBLIC values may live in VITE_* — everything here is inlined
# verbatim into the static browser bundle. NEVER put a DATABASE_URL, HMAC signing
# secret, AWS URL/keys, or any credential in a VITE_* var. See scripts/
# check-bundle-secrets.mjs (runs on `npm run build`) which fails the build if a
# secret-shaped string reaches dist/. All reads go through src/config/runtime.ts.

# --- API base URL ------------------------------------------------------------
# Local dev points at the FastAPI service directly. The DEPLOYED build points at
# the Catalyst API Gateway origin (route `/api/*` → gateway_api function → signed
# context → AppSail). Use the EXACT gateway origin from the Console; never a raw
# AppSail URL and never an AWS URL.
VITE_API_BASE_URL=http://localhost:8000

# --- Authentication ----------------------------------------------------------
# "catalyst" = embedded Catalyst Authentication via the Web SDK (deployed build).
# "offline"  = local dev with a synthetic demo identity (no live project needed).
VITE_AUTH_MODE=offline
# Catalyst Web SDK script (versioned CDN). Only loaded when VITE_AUTH_MODE=catalyst.
# v4.6.1+ is required for generateAuthToken() (cross-domain Slate → API Gateway).
VITE_CATALYST_SDK_URL=https://static.zohocdn.com/catalyst/sdk/js/4.6.1/catalystWebSDK.js
# Send cookies with API calls (needed cross-origin: Slate origin → API Gateway).
# Defaults to true when VITE_AUTH_MODE=catalyst; set explicitly to override.
VITE_API_WITH_CREDENTIALS=

# --- Provenance --------------------------------------------------------------
# Synthetic-data badge shown on the login gate and in the app shell. Every
# DRISHTI record is synthetic; the deployed build advertises this.
VITE_DEMO_BADGE=Synthetic Hackathon Demo

# --- Maps (optional) ---------------------------------------------------------
# Mapillary public read token (client-side) for street-level imagery on the map.
# Get one free at https://www.mapillary.com/dashboard/developers . Optional —
# the Map's street view / coverage overlay degrade gracefully without it.
VITE_MAPILLARY_TOKEN=
