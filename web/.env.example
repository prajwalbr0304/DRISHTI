# DRISHTI web — copy to `.env` (or `.env.local`) and adjust.

# Base URL of the Wave-B ML/analytics FastAPI service. All data is live;
# start the service (see services/ml) so the shell can reach real records.
VITE_API_BASE_URL=http://localhost:8000

# Mapillary public read token (client-side) for street-level imagery on the map.
# Get one free at https://www.mapillary.com/dashboard/developers . Optional —
# the Map's street view / coverage overlay degrade gracefully without it.
VITE_MAPILLARY_TOKEN=
