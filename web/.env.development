# DRISHTI web — DEVELOPMENT env (auto-loaded by `vite` / `vite dev`).
# Committed: contains only public, non-secret local-dev defaults.
# Personal overrides go in `.env.local` (gitignored), e.g. VITE_MAPILLARY_TOKEN.

# Local FastAPI service (services/ml) reached directly — no gateway in dev.
VITE_API_BASE_URL=http://localhost:8000

# Offline auth: a synthetic demo identity, so the shell runs without a live
# Catalyst project or the embedded SDK. The server still owns the real role.
VITE_AUTH_MODE=offline
VITE_API_WITH_CREDENTIALS=false

VITE_DEMO_BADGE=Synthetic Hackathon Demo (dev)
