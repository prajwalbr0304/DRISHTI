node_modules
dist
dist-ssr

# Env files.
#   Committed (public, non-secret build config): .env.example, .env.development,
#   .env.production.
#   NEVER committed (real secrets): .env and any *.local file (.env.local,
#   .env.production.local, …) — e.g. .env.local holds the personal map token.
*.local
.env
!.env.example
!.env.development
!.env.production

# editor / os
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# playwright (E2E) — Prompt 22 §C
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
