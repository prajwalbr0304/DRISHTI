# DRISHTI web — PRODUCTION env (auto-loaded by `vite build`).
# Committed: only PUBLIC, non-secret values. NEVER a secret / DATABASE_URL /
# AWS URL / signing secret here (inlined into the static bundle).

# --- API base URL → Catalyst API Gateway -------------------------------------
# ONE public base URL. Point at the Catalyst API Gateway origin, route `/api/*`
# (→ gateway_api function → signed context → AppSail). Get the EXACT origin from
# the Console after `catalyst apig:enable` + deploy (e.g. the project serverless
# domain). The `/api` suffix is required (gateway_api strips it via
# DRISHTI_GATEWAY_PATH_PREFIX). Never a raw AppSail URL; never an AWS URL.
#
# The placeholder below is intentionally invalid so an un-configured production
# build is caught: scripts/check-bundle-secrets.mjs FAILS the build if this
# token survives into dist/. Override at deploy time via the CI variable
# VITE_API_BASE_URL (Console → Pipelines) or `.env.production.local`.
VITE_API_BASE_URL=https://dhristi-60075362708.development.catalystserverless.in/api

# --- Authentication (Option B: synthetic role-card demo) ---------------------
# The deployed demo uses the OFFLINE role-card picker (click a role -> instant
# synthetic sign-in -> app) INSTEAD of the embedded Catalyst IAM widget, which
# proved unreliable to embed. The API Gateway runs in demo mode (the /api/* route
# auth is set to Optional in the Console + the gateway_api function has
# DRISHTI_DEMO_AUTH=true), so it mints a full-access synthetic signed context
# server-side and live data loads without a Catalyst session.
#
# Catalyst AUTHENTICATION is therefore "Not Used" for the demo login (see
# docs/deployment/CATALYST_CAPABILITY_MATRIX.md). Every OTHER Catalyst service
# stays in use: Data Store, Stratus, Functions, API Gateway, AppSail, Signals,
# scheduled jobs, Cache. To restore real IAM login: VITE_AUTH_MODE=catalyst +
# VITE_API_WITH_CREDENTIALS=true and revert the Console demo-mode toggles.
VITE_AUTH_MODE=offline
# Offline/demo: there is no Catalyst session cookie to send cross-origin.
VITE_API_WITH_CREDENTIALS=false

# --- Provenance --------------------------------------------------------------
VITE_DEMO_BADGE=Synthetic Hackathon Demo
VITE_MAPILLARY_TOKEN=MLY|36424657740511192|19300db5685283f895cb64a4b059c20b
