# DRISHTI web — PRODUCTION env (auto-loaded by `vite build`).
# Committed: only PUBLIC, non-secret values. NEVER a secret / DATABASE_URL /
# AWS URL / signing secret here (inlined into the static bundle).

# --- API base URL → Catalyst API Gateway -------------------------------------
# ONE public base URL. Point at the Catalyst API Gateway origin, route `/api/*`
# (→ gateway_api function → signed context → AppSail). Get the EXACT origin from
# the Console after `catalyst apig:enable` + deploy (e.g. the project serverless
# domain). The `/api` suffix is required (gateway_api strips it via
# DRISHTI_GATEWAY_PATH_PREFIX). Never a raw AppSail URL; never an AWS URL.
#
# The placeholder below is intentionally invalid so an un-configured production
# build is caught: scripts/check-bundle-secrets.mjs FAILS the build if this
# token survives into dist/. Override at deploy time via the CI variable
# VITE_API_BASE_URL (Console → Pipelines) or `.env.production.local`.
VITE_API_BASE_URL=https://dhristi-60075362708.development.catalystserverless.in/api

# --- Authentication ----------------------------------------------------------
# Deployed build uses embedded Catalyst Authentication (Web SDK). The gateway
# derives the role SERVER-SIDE from this identity; the client never sends a
# trusted role.
VITE_AUTH_MODE=catalyst
# Cross-origin (Slate origin → API Gateway origin): send the Catalyst session.
VITE_API_WITH_CREDENTIALS=true

# --- Provenance --------------------------------------------------------------
VITE_DEMO_BADGE=Synthetic Hackathon Demo
