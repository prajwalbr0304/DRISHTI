{
  "name": "drishti-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DRISHTI — crime intelligence human interface (Wave C).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/postbuild-slate.mjs && node scripts/prerender.mjs && node scripts/check-bundle-secrets.mjs",
    "build:release": "tsc --noEmit -p tsconfig.json && vite build && node scripts/postbuild-slate.mjs && node scripts/prerender.mjs && node scripts/check-bundle-secrets.mjs --release",
    "build:fast": "vite build && node scripts/postbuild-slate.mjs && node scripts/prerender.mjs && node scripts/check-bundle-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "slate:config": "node scripts/postbuild-slate.mjs",
    "prerender": "node scripts/prerender.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:bundle:release": "node scripts/check-bundle-secrets.mjs --release",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.6",
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.6",
    "@deck.gl/react": "^9.3.6",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-query": "^5.51.23",
    "@tremor/react": "^3.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.436.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^6.26.1",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "sigma": "^3.0.3",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.65.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.8"
  }
